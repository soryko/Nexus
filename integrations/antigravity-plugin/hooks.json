{
  "nexus-memory-recall": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs start",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs recall",
        "timeout": 5
      }
    ]
  }
}
