{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"", "timeout": 2}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "mcp_tool", "server": "nexus-memory", "tool": "nexus_recall", "timeout": 2,
           "input": {"session_id": "${session_id}", "cwd": "${cwd}", "prompt": "${prompt}"}}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__nexus-memory__.*",
        "hooks": [
          {"type": "mcp_tool", "server": "nexus-memory", "tool": "nexus_pre_tool", "timeout": 2,
           "input": {"session_id": "${session_id}", "cwd": "${cwd}", "tool_name": "${tool_name}", "tool_input": "${tool_input}"}}
        ]
      }
    ]
  }
}
