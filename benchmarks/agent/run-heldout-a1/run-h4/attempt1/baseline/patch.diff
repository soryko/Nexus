diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..fadb7d6 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,13 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> t.Any:
+        # The default ``enum.Enum.__reduce_ex__`` reconstructs the member by
+        # value. Because sentinel values are arbitrary ``object()`` instances,
+        # the value cannot survive a pickle round-trip and lookup fails.
+        # Reconstruct by name instead so every member is preserved as itself.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
