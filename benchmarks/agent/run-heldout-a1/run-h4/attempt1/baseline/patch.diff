     assert value not in real_values
+
+
+@pytest.mark.parametrize("member", list(Sentinel))
+def test_sentinel_pickle_round_trip(member):
+    """Pickling must restore the identical sentinel member.
+
+    Sentinel values are arbitrary ``object()`` instances, which the default
+    enum pickling cannot reconstruct by value.
+    """
+    for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+        assert pickle.loads(pickle.dumps(member, protocol)) is member
+
+
+@pytest.mark.parametrize("member", list(Sentinel))
+def test_sentinel_copy_round_trip(member):
+    assert copy.copy(member) is member
+    assert copy.deepcopy(member) is member
