+@pytest.mark.parametrize("value", list(Sentinel))
+def test_sentinel_pickle(value: Sentinel) -> None:
+    """Every sentinel member must survive a pickle round-trip by identity."""
+    assert pickle.loads(pickle.dumps(value)) is value
+
+
+@pytest.mark.parametrize("value", list(Sentinel))
+def test_sentinel_copy(value: Sentinel) -> None:
+    """Copying a sentinel must return the same member."""
+    assert copy.copy(value) is value
+    assert copy.deepcopy(value) is value
