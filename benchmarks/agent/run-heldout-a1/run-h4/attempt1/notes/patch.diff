index 05ee2e9..13b3953 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,13 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> tuple[t.Any, ...]:
+        # The member values are unique ``object()`` instances, so the default
+        # enum reduction (which reconstructs a member via ``cls(value)``) raises
+        # because the identity of the value cannot survive a pickle round-trip.
+        # Reduce by name instead, resolving the attribute back to this member.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
