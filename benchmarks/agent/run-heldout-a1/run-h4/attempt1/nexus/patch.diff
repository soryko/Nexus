@@ -18,6 +18,14 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> t.Any:
+        # The member values are plain ``object()`` instances, whose identity
+        # is not preserved by pickling. The default ``Enum.__reduce_ex__``
+        # reconstructs a member from its value, so unpickling would call
+        # ``Sentinel(<a new object>)`` and fail with "is not a valid
+        # Sentinel". Reconstruct the singleton by name instead.
+        return getattr, (self.__class__, self._name_)
+
 
