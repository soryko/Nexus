+@pytest.mark.parametrize("member", list(Sentinel))
+def test_sentinel_pickle(member):
+    """Sentinel members survive pickling and round-trip to the same member."""
+    assert pickle.loads(pickle.dumps(member)) is member
+    assert pickle.loads(pickle.dumps(member)) == member
+
+
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_sentinel_pickle_all_protocols(protocol):
+    assert pickle.loads(pickle.dumps(UNSET, protocol)) is UNSET
+
+
+@pytest.mark.parametrize("member", list(Sentinel))
+def test_sentinel_copy(member):
+    """Shallow and deep copies of a sentinel are the member itself."""
+    assert copy.copy(member) is member
+    assert copy.deepcopy(member) is member
