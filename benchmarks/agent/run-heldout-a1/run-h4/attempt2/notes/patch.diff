index 05ee2e9..c83a58e 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,13 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> t.Any:
+        # An enum member is normally pickled by its value, but sentinel values are
+        # plain ``object()`` instances. Unpickling one produces a fresh object
+        # that is not equal to any member, so reconstruction from the value fails.
+        # Pickle by name instead, which round-trips to the exact member.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
