+@pytest.mark.parametrize("member", list(Sentinel))
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_sentinel_pickle_roundtrip(member, protocol):
+    # Enum members are normally pickled by their value, but sentinel values are
+    # plain ``object()`` instances. Unpickling used to build a fresh object that
+    # matched no member, raising ``ValueError: ... is not a valid Sentinel``.
+    assert pickle.loads(pickle.dumps(member, protocol)) is member
+
+
+@pytest.mark.parametrize("member", list(Sentinel))
+def test_sentinel_copy_roundtrip(member):
+    assert copy.copy(member) is member
+    assert copy.deepcopy(member) is member
 
 
