@@ -18,6 +18,12 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> tuple[t.Any, ...]:
+        # Enum pickles members by value, but the members' values are bare
+        # ``object()`` instances that cannot be looked up when unpickling.
+        # Reconstruct the member by name instead so round-tripping works.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
