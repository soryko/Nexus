diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..5c7a2c4 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,13 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> tuple[t.Any, ...]:
+        # Enum members are usually pickled by value, but the values here are
+        # ``object()`` instances. Unpickling recreates a fresh ``object()``
+        # that cannot be matched against the enum's value-to-member map, so
+        # reduce by name instead to return the existing member.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
