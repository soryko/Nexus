+++ b/tests/test_utils/test_sentinel.py
@@ -1,6 +1,11 @@
+import copy
+import pickle
 from decimal import Decimal
 from fractions import Fraction
 
+import pytest
+
+from click._utils import Sentinel
 from click._utils import UNSET
 
 
@@ -50,3 +55,21 @@ def test_unset_sentinel():
         assert value is not real_value
 
     assert value not in real_values
+
+
+@pytest.mark.parametrize("value", list(Sentinel))
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_sentinel_pickle_round_trip(value, protocol):
+    """Every sentinel member survives pickling as the identical member.
+
+    The members' values are ``object()`` instances that do not survive
+    the round trip, so pickling must go through the member name.
+    """
+    assert pickle.loads(pickle.dumps(value, protocol)) is value
+
+
+@pytest.mark.parametrize("value", list(Sentinel))
+def test_sentinel_copy_round_trip(value):
+    """Copying a sentinel member returns the identical member."""
+    assert copy.copy(value) is value
+    assert copy.deepcopy(value) is value
