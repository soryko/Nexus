@@ -18,6 +18,13 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> t.Any:
+        # Enum members pickle by value by default, but the values here are
+        # unique ``object()`` instances that cannot be looked up again. Pickle
+        # by name instead, so a round-tripped member is identical to the
+        # original.
+        return getattr, (self.__class__, self._name_)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
