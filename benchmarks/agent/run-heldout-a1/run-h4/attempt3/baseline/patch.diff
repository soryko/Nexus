+@pytest.mark.parametrize("sentinel", list(Sentinel))
+def test_sentinel_pickle_roundtrip(sentinel):
+    """Every sentinel member survives pickling as the same object."""
+    for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+        assert pickle.loads(pickle.dumps(sentinel, protocol)) is sentinel
+
+
+@pytest.mark.parametrize("sentinel", list(Sentinel))
+def test_sentinel_copy(sentinel):
+    """Copying a sentinel member returns the member rather than a new value."""
+    assert copy.copy(sentinel) is sentinel
+    assert copy.deepcopy(sentinel) is sentinel
