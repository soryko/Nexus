--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,12 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> t.Any:
+        # Enum members pickle by value by default, but our values are unique,
+        # anonymous ``object()`` instances. Reconstruct the member by name so
+        # that unpickling returns the very same enum member.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
