diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..7c1d120 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,14 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, proto: int) -> tuple[t.Any, ...]:
+        # Enum's default pickling serializes the member's value and reconstructs
+        # the member by looking that value up. Sentinel member values are
+        # distinct ``object()`` instances, which do not survive that round trip,
+        # so unpickling raised ``ValueError: ... is not a valid Sentinel``.
+        # Pickle by member name instead, preserving singleton identity.
+        return getattr, (self.__class__, self._name_)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
