     assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
 
 
+@pytest.mark.parametrize(
+    ("type_", "kwargs", "expected"),
+    [
+        (click.Choice(["foo", "bar", "baz"]), {}, "{foo|bar|baz}"),
+        (click.Choice(["foo", "bar", "baz"]), {"required": False}, "[foo|bar|baz]"),
+        (click.Choice(["foo", "bar", "baz"]), {"nargs": -1}, "[foo|bar|baz]..."),
+        (click.DateTime(["%Y-%m-%d"]), {}, "[%Y-%m-%d]"),
+        (click.DateTime(["%Y-%m-%d"]), {"required": False}, "[%Y-%m-%d]"),
+        (click.DateTime(["%Y-%m-%d"]), {"nargs": -1}, "[%Y-%m-%d]..."),
+    ],
+)
+def test_argument_metavar_rendered_by_type_bracketed_once(
+    runner, type_, kwargs, expected
+):
+    """A type that renders its own metavar is not bracketed a second time.
+
+    Optional arguments whose type already includes brackets (``Choice`` or
+    ``DateTime``) used to render ``[[foo|bar|baz]]`` in the usage line.
+    """
+
+    @click.command()
+    @click.argument("method", type=type_, **kwargs)
+    def cli(method):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
