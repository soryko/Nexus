diff --git a/src/click/core.py b/src/click/core.py
index d2db291..4892660 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -3571,9 +3571,14 @@ class Argument(Parameter):
         var = self.type.get_metavar(param=self, ctx=ctx)
         if not var:
             var = self.name.upper()
+        # A type may already bracket its metavar, such as Choice or DateTime
+        # rendering the alternatives as ``[a|b]``. Only add the brackets that
+        # mark the argument as optional when the type has not done so already,
+        # otherwise the usage line gets a redundant pair of brackets.
+        already_bracketed = var.startswith("[") and var.endswith("]")
         if self.deprecated:
             var += "!"
-        if not self.required:
+        if not self.required and not already_bracketed:
             var = f"[{var}]"
         if self.nargs != 1:
             var += "..."
diff --git a/tests/test_arguments.py b/tests/test_arguments.py
index 6015282..a94ada4 100644
--- a/tests/test_arguments.py
+++ b/tests/test_arguments.py
@@ -332,6 +332,41 @@ def test_argument_metavar_marks_optional(runner, kwargs, expected):
     assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
 
 
+@pytest.mark.parametrize(
+    ("kwargs", "expected"),
+    [
+        ({"type": click.Choice(["foo", "bar", "baz"])}, "{foo|bar|baz}"),
+        (
+            {"type": click.Choice(["foo", "bar", "baz"]), "nargs": -1},
+            "[foo|bar|baz]...",
+        ),
+        (
+            {"type": click.Choice(["foo", "bar", "baz"]), "required": False},
+            "[foo|bar|baz]",
+        ),
+        ({"type": click.DateTime(["%Y-%m-%d"]), "required": False}, "[%Y-%m-%d]"),
+        (
+            {"type": click.DateTime(["%Y-%m-%d"]), "nargs": -1},
+            "[%Y-%m-%d]...",
+        ),
+    ],
+)
+def test_bracketed_argument_metavar_not_double_bracketed(runner, kwargs, expected):
+    """A type may render its own bracketed metavar, such as a Choice or a date
+    format. Marking that argument optional must not add a second pair of
+    brackets in the usage line.
+    """
+
+    @click.command()
+    @click.argument("method", **kwargs)
+    def cli(method):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
