diff --git a/src/click/core.py b/src/click/core.py
index d2db291..d7ecbef 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -3571,9 +3571,14 @@ class Argument(Parameter):
         var = self.type.get_metavar(param=self, ctx=ctx)
         if not var:
             var = self.name.upper()
+        # Types like ``Choice`` and ``DateTime`` already surround their metavar
+        # with square brackets to enumerate the allowed values. Reuse those
+        # outer brackets as the optional-argument indicator instead of wrapping
+        # the metavar in a second pair, which would produce ``[[a|b|c]]``.
+        already_bracketed = var.startswith("[") and var.endswith("]")
         if self.deprecated:
             var += "!"
-        if not self.required:
+        if not self.required and not already_bracketed:
             var = f"[{var}]"
         if self.nargs != 1:
             var += "..."
diff --git a/tests/test_arguments.py b/tests/test_arguments.py
index 6015282..35b1ddd 100644
--- a/tests/test_arguments.py
+++ b/tests/test_arguments.py
@@ -332,6 +332,67 @@ def test_argument_metavar_marks_optional(runner, kwargs, expected):
     assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
 
 
+@pytest.mark.parametrize(
+    ("kwargs", "expected"),
+    [
+        (
+            {"type": click.Choice(["foo", "bar", "baz"]), "nargs": -1},
+            "[foo|bar|baz]...",
+        ),
+        (
+            {"type": click.Choice(["foo", "bar", "baz"]), "required": False},
+            "[foo|bar|baz]",
+        ),
+        (
+            {"type": click.Choice(["foo", "bar", "baz"]), "required": True},
+            "{foo|bar|baz}",
+        ),
+        (
+            {"type": click.DateTime(), "nargs": -1},
+            "[%Y-%m-%d|%Y-%m-%dT%H:%M:%S|%Y-%m-%d %H:%M:%S]...",
+        ),
+        (
+            {"type": click.DateTime(), "required": False},
+            "[%Y-%m-%d|%Y-%m-%dT%H:%M:%S|%Y-%m-%d %H:%M:%S]",
+        ),
+    ],
+    ids=["choice-variadic", "choice-optional", "choice-required", "datetime-variadic", "datetime-optional"],
+)
+def test_argument_metavar_not_double_bracketed(runner, kwargs, expected):
+    """A type metavar that already carries brackets isn't wrapped again when
+    the argument is optional. See the usage line for an optional or variadic
+    ``Choice``/``DateTime`` argument."""
+
+    @click.command()
+    @click.argument("method", **kwargs)
+    def cli(method):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
+def test_argument_metavar_brackets_plain_custom_type(runner):
+    """A custom type metavar without its own brackets is still bracketed when
+    the argument is optional."""
+
+    class MyType(click.ParamType):
+        name = "my_type"
+
+        def get_metavar(self, param: click.Parameter, ctx: click.Context):
+            return "MY_TYPE"
+
+    @click.command()
+    @click.argument("arg", type=MyType(), required=False)
+    def cli(arg):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines()[0] == "Usage: cli [OPTIONS] [MY_TYPE]"
+
+
