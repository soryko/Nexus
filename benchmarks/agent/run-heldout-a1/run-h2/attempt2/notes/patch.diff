@@ -0,0 +1,22 @@
+import click
+from click.testing import CliRunner
+
+@click.command()
+@click.argument("method", type=click.Choice(["foo","bar","baz"]), nargs=-1)
+def cli_variadic(method): pass
+
+@click.command()
+@click.argument("method", type=click.Choice(["foo","bar","baz"]), required=False)
+def cli_optional(method): pass
+
+@click.command()
+@click.argument("d", type=click.DateTime())
+def cli_date(d): pass
+
+@click.command()
+@click.argument("d", type=click.DateTime(), required=False)
+def cli_date_opt(d): pass
+
+r = CliRunner()
+for c in (cli_variadic, cli_optional, cli_date, cli_date_opt):
+    print(r.invoke(c, ["--help"]).output.splitlines()[0])
