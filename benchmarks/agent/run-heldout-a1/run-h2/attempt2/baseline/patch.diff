@@ -0,0 +1,21 @@
+import click
+from click.testing import CliRunner
+
+@click.command(name="cli-variadic")
+@click.argument("method", type=click.Choice(["foo", "bar", "baz"]), nargs=-1)
+def variadic(method):
+    pass
+
+@click.command(name="cli-optional")
+@click.argument("method", type=click.Choice(["foo", "bar", "baz"]), required=False)
+def optional(method):
+    pass
+
+@click.command(name="cli-date")
+@click.argument("when", type=click.DateTime(), required=False)
+def date(when):
+    pass
+
+r = CliRunner()
+for c in (variadic, optional, date):
+    print(r.invoke(c, ["--help"]).output.splitlines()[0])
