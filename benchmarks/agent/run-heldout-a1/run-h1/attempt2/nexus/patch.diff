@@ -0,0 +1,20 @@
+import click
+from click.testing import CliRunner
+
+def make(order):
+    @click.command()
+    def cli(xyz):
+        click.echo(xyz)
+    opts = [click.option("--without-xyz", "xyz", flag_value=False),
+            click.option("--with-xyz", "xyz", flag_value=True, default=True)]
+    if order == "reverse":
+        opts = opts[::-1]
+    for o in opts:
+        cli = o(cli)
+    return cli
+
+r = CliRunner()
+for order in ("normal", "reverse"):
+    for args in ([], ["--with-xyz"], ["--without-xyz"], ["--with-xyz","--without-xyz"], ["--without-xyz","--with-xyz"]):
+        res = r.invoke(make(order), args)
+        print(order, args, "->", repr(res.output.strip()), "exc:", res.exception)
