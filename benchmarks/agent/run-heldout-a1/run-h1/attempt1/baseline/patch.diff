+import click
+from click.testing import CliRunner
+
+@click.command()
+@click.option("--without-xyz", "xyz", flag_value=False)
+@click.option("--with-xyz", "xyz", flag_value=True, default=True)
+def cli(xyz):
+    click.echo(repr(xyz))
+
+r = CliRunner()
+for a in ([], ["--with-xyz"], ["--without-xyz"], ["--without-xyz","--with-xyz"], ["--with-xyz","--without-xyz"]):
+    print(a, r.invoke(cli, a).output.strip())
