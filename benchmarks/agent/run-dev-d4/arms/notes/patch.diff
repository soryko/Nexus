@@ -0,0 +1,20 @@
+from __future__ import annotations
+
+import pytest
+
+import click
+
+
+@pytest.mark.integration
+def test_group_invokes_subcommand(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    def hello():
+        click.echo("hello")
+
+    result = runner.invoke(cli, ["hello"])
+    assert result.exit_code == 0
+    assert result.output == "hello\n"
