@@ -0,0 +1,19 @@
+from __future__ import annotations
+
+import pytest
+
+import click
+
+
+@pytest.mark.integration
+def test_integration_marker(runner):
+    """A test using the registered ``integration`` marker collects and runs."""
+
+    @click.command()
+    def cli():
+        click.echo("integrated")
+
+    result = runner.invoke(cli)
+
+    assert result.exit_code == 0
+    assert result.output == "integrated\n"
