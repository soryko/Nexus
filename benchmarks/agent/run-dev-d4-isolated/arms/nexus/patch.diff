@@ -0,0 +1,22 @@
+"""End-to-end tests that exercise multiple components together."""
+
+from __future__ import annotations
+
+import pytest
+
+from click.testing import CliRunner
+
+
+@pytest.mark.integration
+def test_runner_invokes_command_with_options(runner: CliRunner) -> None:
+    """A command's options and output work end to end through ``CliRunner``."""
+    import click
+
+    @click.command()
+    @click.option("--name", required=True)
+    def greet(name: str) -> None:
+        click.echo(f"hello {name}")
+
+    result = runner.invoke(greet, ["--name", "world"])
+    assert result.exit_code == 0
+    assert result.output == "hello world\n"
