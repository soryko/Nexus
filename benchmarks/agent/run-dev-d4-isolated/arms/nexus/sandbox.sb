(version 1)
(allow default)

; ---- network: deny everything, then re-admit only the local forwarder ----
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))

; ---- filesystem: the arm may not read the answers or its siblings ----
(deny file-read* (subpath "/private/tmp/claude-501/-Users-soko-Cerebros-nexus-memory/3a1f29bd-bbe5-4757-8711-792724cbc000/scratchpad/run-d4iso/base/checks"))
