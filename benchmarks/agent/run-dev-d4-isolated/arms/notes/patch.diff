+from __future__ import annotations
+
+import pytest
+
+import click
+
+
+@pytest.mark.integration
+def test_integration_group_subcommand(runner):
+    """An end-to-end invocation of a group and its subcommand."""
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--name", default="World")
+    def greet(name):
+        click.echo(f"Hello {name}!")
+
+    result = runner.invoke(cli, ["greet", "--name", "Click"])
+    assert result.exit_code == 0
+    assert result.output == "Hello Click!\n"
