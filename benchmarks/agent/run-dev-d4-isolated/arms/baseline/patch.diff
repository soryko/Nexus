+from __future__ import annotations
+
+import pytest
+
+import click
+
+
+@pytest.mark.integration
+def test_group_with_option_and_subcommand(runner):
+    """A group, a shared option, and a subcommand work together."""
+
+    @click.group()
+    @click.option("--verbose", is_flag=True)
+    @click.pass_context
+    def cli(ctx, verbose):
+        ctx.obj = {"verbose": verbose}
+
+    @cli.command()
+    @click.argument("name")
+    @click.pass_context
+    def greet(ctx, name):
+        click.echo(f"hello {name}")
+
+    result = runner.invoke(cli, ["--verbose", "greet", "world"])
+    assert result.exit_code == 0
+    assert result.output == "hello world\n"
