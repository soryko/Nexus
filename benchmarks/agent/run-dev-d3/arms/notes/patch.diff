+def test_default_map_unset_falls_back_to_default(runner):
+    """A literal :attr:`UNSET` stored in ``default_map`` means the map did not
+    supply a value, so the parameter's own default is used instead of ``None``.
+
+    The sentinel is internal: reading it back out of a mapping must be treated
+    as absence, not as data to hand to the callback.
+    """
+
+    @click.command(context_settings={"default_map": {"port": UNSET}})
+    @click.option("--port", default=8000)
+    def cli(port):
+        click.echo(f"port={port}")
+
+    result = runner.invoke(cli, [])
+    assert not result.exception
+    assert result.output == "port=8000\n"
+
+    # An explicit value still wins over the parameter default.
+    result = runner.invoke(cli, ["--port", "9000"])
+    assert not result.exception
+    assert result.output == "port=9000\n"
+
+
+def test_default_map_unset_without_parameter_default(runner):
+    """An ``UNSET`` ``default_map`` entry does not invent a value for a
+    parameter that has no default of its own; the value stays missing."""
+
+    @click.command(context_settings={"default_map": {"port": UNSET}})
+    @click.option("--port", required=True)
+    def cli(port):
+        click.echo(f"port={port}")
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code != 0
+    assert "Missing option '--port'" in result.output
+
+
