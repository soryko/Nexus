+def test_default_map_unset_falls_back_to_parameter_default(runner):
+    """An ``UNSET`` entry in ``default_map`` is treated as if the key were absent.
+
+    Regression test: a command declaring
+    ``context_settings={"default_map": {"port": UNSET}}`` with an option
+    ``@click.option("--port", default=8000)`` invoked without arguments must
+    report ``8000``, not ``None``.
+    """
+
+    @click.command(context_settings={"default_map": {"port": UNSET}})
+    @click.option("--port", default=8000, show_default=True)
+    def cli(port):
+        click.echo(f"port={port}")
+
+    result = runner.invoke(cli, [])
+    assert not result.exception
+    assert result.output == "port=8000\n"
+
+    # The value comes from the parameter's own default, not the default_map.
+    @click.command(context_settings={"default_map": {"port": UNSET}})
+    @click.option("--port", default=8000)
+    @click.pass_context
+    def cli_source(ctx, port):
+        click.echo(ctx.get_parameter_source("port").name)
+
+    result = runner.invoke(cli_source, [])
+    assert not result.exception
+    assert result.output == "DEFAULT\n"
+
+    # Help rendering also falls back to the parameter's default.
+    result = runner.invoke(cli, ["--help"])
+    assert not result.exception
+    assert "default: 8000" in result.output
+
+    # A command-line value still takes precedence.
+    result = runner.invoke(cli, ["--port", "1234"])
+    assert not result.exception
+    assert result.output == "port=1234\n"
+
+
+def test_default_map_unset_argument_falls_back(runner):
+    """``UNSET`` in ``default_map`` also falls back for arguments."""
+
+    @click.command(context_settings={"default_map": {"name": UNSET}})
+    @click.argument("name", default="world")
+    def cli(name):
+        click.echo(f"name={name}")
+
+    result = runner.invoke(cli, [])
+    assert not result.exception
+    assert result.output == "name=world\n"
+
+
