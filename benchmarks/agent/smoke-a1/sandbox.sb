(version 1)
(allow default)

; ---- network: deny everything, then re-admit only the forwarder's loopback port ----
(deny network-outbound)
(allow network-outbound (remote ip "localhost:8899"))

; ---- filesystem: deny reads, then re-admit the runtime and this arm's own checkout ----
(deny file-read*)
(allow file-read-metadata)   ; path resolution only -- conveys no file contents
(allow file-read* (literal "/"))   ; the root directory entry; dyld aborts without it

(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/Applications"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/etc"))
(allow file-read* (subpath "/dev"))
(allow file-read* (subpath "/private/var/folders"))
(allow file-read* (subpath "/private/var/db"))
(allow file-read* (subpath "/private/var/run"))
(allow file-read* (subpath "/private/var/select"))
(allow file-read* (subpath "/opt/homebrew"))
(allow file-read* (subpath "/opt/local"))
(allow file-read* (subpath "/Users/soko/.local/share/claude"))
(allow file-read* (subpath "/Users/soko/.local/bin"))
(allow file-read* (subpath "/Users/soko/.local/state"))
(allow file-read* (subpath "/Users/soko/.nvm"))
(allow file-read* (subpath "/Users/soko/.npm"))
