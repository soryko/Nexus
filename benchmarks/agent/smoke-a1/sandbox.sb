(allow file-read* (subpath "/private/tmp/claude-501/-private-tmp-claude-501--Users-soko-Cerebros-nexus-memory-2875a44a-2ea4-4a24-8ab3-dcad1b9ab047-scratchpad-smoke-run-arms-nexus-repo"))
