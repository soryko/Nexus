{
  "nexus-correlation-probe": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./probe_hook.mjs SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./probe_hook.mjs PreInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./probe_hook.mjs Stop",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./probe_hook.mjs PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./probe_hook.mjs PostToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
