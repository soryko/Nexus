diff --git a/tests/transport/test_usage_via.py b/tests/transport/test_usage_via.py
new file mode 100644
index 0000000..12f7e3c
--- /dev/null
+++ b/tests/transport/test_usage_via.py
@@ -0,0 +1,23 @@
+"""Hook-driven lifecycle calls are logged via="hook", so no pilot counts them as model consults."""
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from nexus_memory.transport.usage import HOOK_TOOLS, MODEL_TOOLS, UsageLog, UsageMiddleware
+
+
+@pytest.mark.parametrize("tool", sorted(HOOK_TOOLS | MODEL_TOOLS | {"unknown"}))
+def test_every_call_line_carries_via(tmp_path: Path, tool: str) -> None:
+    log = UsageLog(tmp_path / "usage.jsonl", tmp_path / "db.sqlite3")
+    UsageMiddleware(log)._call(SimpleNamespace(session=None, params={}), tool, "ok", time.monotonic(), {})
+    call = [json.loads(line) for line in (tmp_path / "usage.jsonl").read_text().splitlines()][-1]
+    assert call["event"] == "call" and call["tool"] == tool
+    assert call["via"] == ("hook" if tool in HOOK_TOOLS else "model")
+
+
+def test_hook_and_model_tool_names_do_not_overlap() -> None:
+    assert not HOOK_TOOLS & MODEL_TOOLS
